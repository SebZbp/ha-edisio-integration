# Normalise text files to LF in the repo; Windows checkouts may convert them to CRLF.
* text=auto
# Shell scripts and the justfile must stay LF everywhere: bash on Windows (Git Bash)
# fails on CRLF with "$'\r': command not found".
*.sh text eol=lf
*.just text eol=lf
justfile text eol=lf
git-credential-beads text eol=lf
.githooks/* text eol=lf
