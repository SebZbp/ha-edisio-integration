#!/usr/bin/env bash
# Git credential helper for a Bitbucket Beads remote: serves the token at <secret-path> to the x-token-auth user only.
# Registered globally by beads.sh as: git-credential-beads <secret-path>. Fails closed (quit=1) within 20s.
# GitHub remotes do not use it: they authenticate through gh auth setup-git.
set -euo pipefail

secret_path="${1:?usage: git-credential-beads <secret-path> get}"
[ "${2:-}" = "get" ] || exit 0
grep -qx 'username=x-token-auth' <<<"$(cat)" || exit 0

to=gtimeout   # GNU timeout only: Windows ships an unrelated timeout.exe
if command -v timeout >/dev/null 2>&1 && timeout --version 2>/dev/null | grep -q GNU; then to=timeout; fi
if token=$("$to" 20 aws secretsmanager get-secret-value --secret-id "$secret_path" \
    --query SecretString --output text | jq -er '.token | select(. != "")'); then
  printf 'username=x-token-auth\npassword=%s\n' "$token"
else
  echo "git-credential-beads: no token at $secret_path (expired AWS session?)" >&2
  echo "quit=1"   # stop git from falling back to an interactive prompt
fi
